      {
        "name": "平面化",
        "icon": "NONE",
        "cmd_type": "PYTHON_INLINE",
        "operator_id": "mesh.looptools_flatten",
        "operator_kwargs": "",
        "operator_context": "INVOKE_DEFAULT",
        "script_name": "",
        "python_code": "import bmesh, mathutils; bm = bmesh.from_edit_mesh(context.edit_object.data); sv = [v for v in bm.verts if v.select]; n = (sum((v.normal for v in sv), mathutils.Vector((0,0,0)))); n.normalize() if n.length > 0 else None; c = sum((v.co for v in sv), mathutils.Vector((0,0,0))) / len(sv) if sv else None; [setattr(v, 'co', v.co - n * (v.co - c).dot(n)) for v in sv] if (sv and n.length > 0) else None; bmesh.update_edit_mesh(context.edit_object.data)",
